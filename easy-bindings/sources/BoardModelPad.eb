entity BoardModelPad {
  property @generateDirectAccess CanariLength x default ".zero" ;
  property @generateDirectAccess CanariLength y default ".zero" ;
  property @generateDirectAccess CanariLength width default ".zero" ;
  property @generateDirectAccess CanariLength height default ".zero" ;
  property @generateDirectAccess PadShape shape default rect ;
  property @generateDirectAccess Int rotation default 0 ;
}

