entity SegmentEntity {
  property @generateDirectAccess CanariLength x1 default ".zero" ;
  property @generateDirectAccess CanariLength y1 default ".zero" ;
  property @generateDirectAccess CanariLength x2 default ".zero" ;
  property @generateDirectAccess CanariLength y2 default ".zero" ;
  property @generateDirectAccess CanariLength width default ".zero" ;
  property @generateDirectAccess TrackEndStyle endStyle default round ;
}

