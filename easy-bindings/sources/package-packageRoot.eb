graphic entity PackageDimension : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength x1 default ".zero" ;
  property @signature @generateDirectAccess CanariLength y1 default ".zero" ;
  property @signature @generateDirectAccess CanariLength x2 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength y2 default ".zero" ;
  property @signature @generateDirectAccess CanariLength xDimension default ".zero" ;
  property @signature @generateDirectAccess CanariLength yDimension default ".zero" ;

  property @signature @generateDirectAccess CanariLengthUnit x1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y1Unit default ".mil" ;

  property @signature @generateDirectAccess CanariLengthUnit x2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit xDimensionUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yDimensionUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit distanceUnit default ".mil" ;
  property @signature @generateDirectAccess Bool drawDimensionBackground default yes ;


  transient CanariLength distanceInCanariUnit dependsFrom
     self.x1, self.y1, self.x2, self.y2
  ;

  override transient EBShape objectDisplay dependsFrom
     self.x1, self.y1, self.x2, self.y2,
     self.xDimension, self.yDimension, self.distanceInCanariUnit, self.distanceUnit, prefs.dimensionFont,
     self.drawDimensionBackground,
     prefs.packageBackgroundColor,
     prefs.packageDimensionColor
  ;

  override transient EBShape selectionDisplay dependsFrom
    prefs.selectionHiliteColor,
    self.x1, self.y1, self.x2, self.y2,
    prefs.packageBackgroundColor,
    prefs.packageDimensionColor,
    self.drawDimensionBackground,
    self.xDimension, self.yDimension, self.distanceInCanariUnit, self.distanceUnit, prefs.dimensionFont,
    super.PackageObject.knobSize
  ;

  override transient CanariIssueArray issues dependsFrom self.x1, self.y1, self.x2, self.y2 ;
}

//--------------------------------------------------------------------------------------------------

graphic entity PackageZone : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength x default ".zero" ;
  property @signature @generateDirectAccess CanariLength y default ".zero" ;
  property @signature @generateDirectAccess CanariLength width default ".mil (200)" ;
  property @signature @generateDirectAccess CanariLength height default ".mil (200)" ;

  property @signature @generateDirectAccess CanariLengthUnit xUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit widthUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit heightUnit default ".mil" ;

  property @signature @generateDirectAccess String zoneName default "" ;
  property Bool displayZoneName default yes ;
  property Bool displayZoneNameWithPadNumbers default yes ;
  toMany @signature @generateDirectAccess ForbiddenPadNumber forbiddenPadNumbers ;
  property @signature @generateDirectAccess CanariLength xName default ".mil (100)" ;
  property @signature @generateDirectAccess CanariLength yName default ".mil (100)" ;
  property @signature @generateDirectAccess CanariLengthUnit xNameUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yNameUnit default ".mil" ;

//--- Pad numbering
  property @signature @generateDirectAccess PadNumbering zoneNumbering default noNumbering ;

  override transient EBShape objectDisplay dependsFrom
     self.x, self.y, self.width, self.height,
     self.xName, self.yName, self.zoneName, prefs.padZoneFont, prefs.padZoneColor,
     self.displayZoneName
  ;

  override transient EBShape selectionDisplay dependsFrom
    prefs.selectionHiliteColor,
     self.x, self.y, self.width, self.height,
     self.xName, self.yName, self.zoneName, prefs.padZoneFont,
     prefs.packageBackgroundColor,
     prefs.padZoneColor,
     super.PackageObject.knobSize,
     self.displayZoneName
  ;

  override transient CanariIssueArray issues dependsFrom
    self.x, self.y, self.width, self.height,
    self.xName, self.yName, self.zoneName
  ;

  transient CanariRect rect dependsFrom self.x, self.y, self.width, self.height ;
  
  transient StringArray forbiddenPadArray dependsFrom self.forbiddenPadNumbers.all.padNumber ;
  
  transient Bool emptyForbiddenPadArray dependsFrom self.forbiddenPadNumbers.count ;
}

//--------------------------------------------------------------------------------------------------

entity ForbiddenPadNumber {
  property @generateDirectAccess @signature Int padNumber default 0 ;
}

//--------------------------------------------------------------------------------------------------

graphic handlingOpposite entity PackageModelImageDoublePoint {
  toOne @weak PackageRoot mRoot inverse toMany mModelImageObjects ;

  property @generateDirectAccess CanariLength mFirstX default ".mil (200)" ;
  property @generateDirectAccess CanariLength mFirstY default ".mil (200)" ;
  property NSColor mFirstColor default green ;

  property @generateDirectAccess CanariLength mSecondDx default ".mil (200)" ;
  property @generateDirectAccess CanariLength mSecondDy default ".mil (200)" ;
  property NSColor mSecondColor default brown ;

  transient EBShape objectDisplay dependsFrom
     self.mFirstX, self.mFirstY, self.mFirstColor,
     self.mSecondDx, self.mSecondDy, self.mSecondColor, self.mRoot.one.mModelPointsCircleRadius,
     self.mRoot.one.mPointsAreLocked
  ;

  transient EBShape selectionDisplay dependsFrom
    prefs.selectionHiliteColor,
     self.mFirstX, self.mFirstY,
     self.mSecondDx, self.mSecondDy, self.mRoot.one.mModelPointsCircleRadius
  ;
}

