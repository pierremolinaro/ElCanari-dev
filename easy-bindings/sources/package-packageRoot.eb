//--------------------------------------------------------------------------------------------------

abstract graphic handlingOpposite entity PackageObject {
  toOne @weak PackageRoot mRoot inverse toMany packageObjects ;
  abstract transient CanariIssueArray issues ;
  
  transient Double knobSize dependsFrom self.mRoot.one.knobSizeMultpliedByTen ;
}

//--------------------------------------------------------------------------------------------------

enum PadNumbering {
  noNumbering,
  counterClock,
  upRight,
  upLeft,
  downRight,
  downLeft,
  rightUp,
  rightDown,
  leftUp,
  leftDown
}

func enum PadNumbering.popupTitles {
  noNumbering : "No" ;
  counterClock : "Counterclock" ;
  upRight : "Up, Right" ;
  upLeft : "Up, Left" ;
  downRight : "Down, Right" ;
  downLeft  : "Down, Left" ;
  rightUp : "Right, Up" ;
  rightDown : "Right, Down" ;
  leftUp : "Left, Up" ;
  leftDown : "Left, Down" ;
}

//----------------------------------------------------------------------------*

handlingOpposite entity PackageRoot {
//--- Selected page index
  property @generateDirectAccess Int selectedPageIndex default 1 ;

//--- Selected inspector
  property Int selectedInspector default 0 ;

//--- Comment
  property @generateDirectRead @signature String comments default "" ;

//--- Program
  property @generateDirectAccess @signature String program default "" ;

//--- Package definition
  toMany @signature @generateDirectAccess PackageObject packageObjects inverse toOne mRoot ;
  toMany PackagePad packagePads dependsFrom self.packageObjects ;
  toMany PackageSlavePad packageSlavePads dependsFrom self.packageObjects ;
  toMany PackageZone packageZones dependsFrom self.packageObjects ;

//--- Grid and display inspector
  property Bool horizontalFlip default no ;
  property Bool verticalFlip default no ;
  property GridStyle gridStyle default line ;
  property CanariLength gridStep default ".mil (25)" ;
  property CanariLengthUnit gridStepUnit default ".mil" ; // mil
  property Int gridDisplayFactor default 4 ;
  property Int zoom default 600 ;

  property Double mModelImageOpacity default 0.5 ;

//--- Model Image Page
  property Bool mModelImagePageHorizontalFlip default no ;
  property Bool mModelImagePageVerticalFlip default no ;
  property GridStyle mModelImagePageGridStyle default noGrid ;
  property CanariLength mModelImagePageGridStep default ".mil (1)" ;
  property CanariLengthUnit mModelImagePageGridStepUnit default ".mil" ; // mil
  property Int mModelImagePageGridDisplayFactor default 100 ;
  property @generateResetMethod @generateDirectAccess Int mModelImagePageZoom default 200 ;
  property CanariLengthUnit mModelImagePageXPlacardUnit default ".mil" ; // mils
  property CanariLengthUnit mModelImagePageYPlacardUnit default ".mil" ; // mils
  property CanariLengthUnit mModelImageSecondPointXUnit default ".mil" ; // mils
  property CanariLengthUnit mModelImageSecondPointYUnit default ".mil" ; // mils

  property @generateResetMethod @generateDirectAccess Data mModelImageData default empty ;
  property @generateResetMethod @generateDirectAccess CanariLength mModelImageFirstPointXOnLock default ".zero" ;
  property @generateResetMethod @generateDirectAccess CanariLength mModelImageFirstPointYOnLock default ".zero" ;
  property @generateDirectAccess CanariLength mModelImagePointsDxOnLock default ".zero" ;
  property @generateDirectAccess CanariLength mModelImagePointsDyOnLock default ".zero" ;
  property @generateResetMethod @generateDirectAccess Double mModelImageScale default 1.0 ;
  property @generateResetMethod @generateDirectAccess Double mModelImageRotationInRadians default 0.0 ;
  property @generateResetMethod Int mModelPointsCircleRadius default 10 ;
//  property @generateResetMethod CanariLength mModelPointsCircleRadius default ".pt (10)" ;
  property @generateResetMethod @generateDirectAccess Bool mPointsAreLocked default no ;

  property CanariLengthUnit mDimensionUnitFirstModelPointX default ".mil" ;
  property CanariLengthUnit mDimensionUnitFirstModelPointY default ".mil" ;
  property CanariLengthUnit mDimensionUnitSecondModelPointDx default ".mil" ;
  property CanariLengthUnit mDimensionUnitSecondModelPointDy default ".mil" ;
 
  toOne PackageModelImageDoublePoint mModelImageDoublePoint ;
  property proxy CanariLength mModelImageFirstPointX : mModelImageDoublePoint.mFirstX ;
  property proxy CanariLength mModelImageFirstPointY : mModelImageDoublePoint.mFirstY ;

  property proxy CanariLength mModelImageSecondPointDx : mModelImageDoublePoint.mSecondDx ;
  property proxy CanariLength mModelImageSecondPointDy : mModelImageDoublePoint.mSecondDy ;

  toMany @generateDirectAccess PackageModelImageDoublePoint mModelImageObjects inverse toOne mRoot ;

//--- Knob size
  property Int knobSizeMultpliedByTen default 20 ;

//--- Pad numbering
  property @generateDirectRead PadNumbering padNumbering default noNumbering ;
  transient Bool freePadNumbering dependsFrom self.padNumbering ;
  transient Bool counterClockNumbering dependsFrom self.padNumbering ;
  property @generateDirectRead @signature Int counterClockNumberingStartAngle default 90 ;

//--- XY placard unit
  property @signature CanariLengthUnit xPlacardUnit default ".mil" ; // mils
  property @signature CanariLengthUnit yPlacardUnit default ".mil" ; // mils

//--- Issues
  transient CanariIssueArray issues dependsFrom
    self.packageObjects.all.issues, self.packageZones.all.rect,
    self.packageZones.all.zoneName, self.packageZones.all.xName, self.packageZones.all.yName, prefs.padZoneFont
  ;

 //--- Mouse grid
  transient CanariLength gridStepMultipliedByDisplayFactor dependsFrom self.gridStep, self.gridDisplayFactor ;

 //--- Pad number display
   transient EBShape padNumberDisplay dependsFrom
     prefs.showPadNumber,
     self.packagePads.all.padNumberDisplay,
     self.packageSlavePads.all.padNumberDisplay
   ;
 
  transient EBShape backgroundImagePageBackgroundDisplay dependsFrom
    self.packageObjects.all.objectDisplay,
    self.mModelImageData
  ;
 
  transient CanariLength secondPointX dependsFrom
    self.mModelImageFirstPointX, self.mModelImageSecondPointDx
  ;
 
  transient CanariLength secondPointY dependsFrom
    self.mModelImageFirstPointY, self.mModelImageSecondPointDy
  ;
 
  transient String modelImageSizeString dependsFrom self.mModelImageData ;
 
  transient Bool hasModelImage dependsFrom self.mModelImageData ;
  
  transient NSImage lockImageView dependsFrom self.mPointsAreLocked ;
  
  transient IntArray masterPadObjectIndexArray dependsFrom self.packagePads.all.masterPadObjectIndex ;
}

//--------------------------------------------------------------------------------------------------

graphic entity PackageSegment : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength x1 default ".zero" ;
  property @signature @generateDirectAccess CanariLength y1 default ".zero" ;
  property @signature @generateDirectAccess CanariLength x2 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength y2 default ".mil (300)" ;

  property @signature @generateDirectAccess CanariLengthUnit x1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit x2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit lengthUnit default ".mil" ;

  transient NSBezierPath strokeBezierPath dependsFrom self.x1, self.y1, self.x2, self.y2 ;

  override transient EBShape objectDisplay dependsFrom
     self.strokeBezierPath, prefs.packageColor, prefs.packageDrawingWidthMultipliedByTen
  ;

  override transient EBShape selectionDisplay dependsFrom
     prefs.selectionHiliteColor,
     self.x1, self.y1, self.x2, self.y2, super.PackageObject.knobSize ;

  override transient CanariIssueArray issues dependsFrom self.x1, self.y1, self.x2, self.y2 ;

  transient CanariLength lengthInCanariUnit dependsFrom self.x1, self.y1, self.x2, self.y2 ;
}

//--------------------------------------------------------------------------------------------------

graphic entity PackageBezier : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength x1 default ".zero" ;
  property @signature @generateDirectAccess CanariLength y1 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength x2 default ".zero" ;
  property @signature @generateDirectAccess CanariLength y2 default ".zero" ;
  property @signature @generateDirectAccess CanariLength cpx1 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength cpy1 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength cpx2 default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength cpy2 default ".zero" ;

  property @signature @generateDirectAccess CanariLengthUnit x1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit x2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit y2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit cpx1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit cpy1Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit cpx2Unit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit cpy2Unit default ".mil" ;

  transient NSBezierPath strokeBezierPath dependsFrom
     self.x1, self.y1, self.x2, self.y2,
     self.cpx1, self.cpy1, self.cpx2, self.cpy2
  ;

  override transient EBShape objectDisplay dependsFrom
     self.strokeBezierPath,
     prefs.packageColor, prefs.packageDrawingWidthMultipliedByTen
  ;

  override transient EBShape selectionDisplay dependsFrom
    prefs.selectionHiliteColor,
    self.x1, self.y1, self.x2, self.y2,
    self.cpx1, self.cpy1, self.cpx2, self.cpy2,
    super.PackageObject.knobSize
  ;

  override transient CanariIssueArray issues dependsFrom
    self.x1, self.y1, self.x2, self.y2,
    self.cpx1, self.cpy1, self.cpx2, self.cpy2
  ;
}

//--------------------------------------------------------------------------------------------------

graphic entity PackageOval : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength x default ".zero" ;
  property @signature @generateDirectAccess CanariLength y default ".zero" ;
  property @signature @generateDirectAccess CanariLength width default ".mil (300)" ;
  property @signature @generateDirectAccess CanariLength height default ".mil (300)" ;

  property @signature @generateDirectAccess CanariLengthUnit xUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit widthUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit heightUnit default ".mil" ;

  transient NSBezierPath strokeBezierPath dependsFrom
     self.x, self.y, self.width, self.height
  ;

  override transient EBShape objectDisplay dependsFrom
     self.strokeBezierPath,
     prefs.packageColor, prefs.packageDrawingWidthMultipliedByTen
  ;

  override transient EBShape selectionDisplay dependsFrom
     prefs.selectionHiliteColor,
     self.x, self.y, self.width, self.height, super.PackageObject.knobSize
  ;

  override transient CanariIssueArray issues dependsFrom self.x, self.y, self.width, self.height ;
}

//--------------------------------------------------------------------------------------------------

graphic entity PackageArc : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength xCenter default ".mil (150)" ;
  property @signature @generateDirectAccess CanariLength yCenter default ".mil (150)" ;
  property @signature @generateDirectAccess CanariLength radius default ".mil (150)" ;
  property @signature @generateDirectAccess CanariAngle  startAngle default 45_000 ; // In degrees * 1000
  property @signature @generateDirectAccess CanariAngle  arcAngle default 270_000 ; // In degrees * 1000
  property @signature @generateDirectAccess CanariLength startTangent default ".zero" ;
  property @signature @generateDirectAccess CanariLength endTangent default ".zero" ;
  property @signature Bool pathIsClosed default no ;

  property @signature @generateDirectAccess CanariLengthUnit xCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit radiusUnit  default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit startTangentUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit endTangentUnit default ".mil" ;

  transient BezierPath strokeBezierPath dependsFrom
     self.xCenter, self.yCenter, self.radius, self.startAngle, self.arcAngle,
     self.pathIsClosed, self.startTangent, self.endTangent
  ;

  override transient EBShape objectDisplay dependsFrom
     self.strokeBezierPath,
     prefs.packageColor, prefs.packageDrawingWidthMultipliedByTen
  ;

  override transient EBShape selectionDisplay dependsFrom
     prefs.selectionHiliteColor,
     self.xCenter, self.yCenter, self.radius, self.startAngle, self.arcAngle,
     self.startTangent, self.endTangent, self.pathIsClosed,
     super.PackageObject.knobSize
  ;

  override transient CanariIssueArray issues dependsFrom
    self.xCenter, self.yCenter, self.radius, self.startAngle, self.arcAngle, self.pathIsClosed
  ;
}

//--------------------------------------------------------------------------------------------------

graphic handlingOpposite entity PackagePad : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength xCenter default ".zero" ;
  property @signature @generateDirectAccess CanariLength yCenter default ".zero" ;
  property @signature @generateDirectAccess CanariLength width default ".mil (50)" ;
  property @signature @generateDirectAccess CanariLength height default ".mil (100)" ;
  property @signature @generateDirectAccess CanariLength holeWidth default ".mil (25)" ;
  property @signature @generateDirectAccess CanariLength holeHeight default ".mil (25)" ;
  property @signature @generateDirectAccess PadShape padShape default octo ;
  property @signature @generateDirectAccess PadStyle padStyle default traversing ;
  property @signature @generateDirectAccess Int padNumber default 0 ;

  property @signature @generateDirectAccess CanariLengthUnit xCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit widthUnit  default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit heightUnit  default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit holeWidthUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit holeHeightUnit default ".mil" ;
  property @signature CanariLengthUnit annularRingUnit default ".mil" ;

  toOne PackageZone zone ;
  toMany @signature @generateDirectRead PackageSlavePad slaves inverse toOne master ;

  override transient EBShape objectDisplay dependsFrom
     self.xCenter, self.yCenter, self.width, self.height, self.holeWidth, self.holeHeight,
     self.padShape, self.padStyle,
     prefs.frontSidePadColor, prefs.displayPackageFrontSidePads,
     prefs.backSidePadColor, prefs.displayPackageBackSidePads
  ;

  override transient EBShape selectionDisplay dependsFrom
     prefs.selectionHiliteColor,
     self.xCenter, self.yCenter, self.width, self.height, self.padShape
  ;

   transient EBShape padNumberDisplay dependsFrom
     self.xCenter, self.yCenter,
     prefs.padNumberFont, prefs.padNumberColor, self.padNameForDisplay
  ;

  override transient CanariIssueArray issues dependsFrom
    self.xCenter, self.yCenter, self.width, self.height, self.holeWidth, self.holeHeight ;

  transient Bool padIsTraversing dependsFrom self.padStyle ;

  transient CanariLength annularRing dependsFrom self.width, self.height, self.holeWidth, self.holeHeight ;

  transient String padNameWithZoneName dependsFrom
     self.padNumber,
     self.zone.one.zoneName ;

  transient String padNameForDisplay dependsFrom
     self.padNumber,
     self.zone.one.zoneName, self.zone.one.displayZoneNameWithPadNumbers ;

  transient String zoneName dependsFrom self.zone.one.zoneName ;

  transient Bool noZone dependsFrom self.zone.none ;

  transient Bool zoneAllowsManualRenumbering dependsFrom self.zone.one.zoneNumbering ;

  transient Int slavePadCount dependsFrom self.slaves.count ;
  
  transient Int masterPadObjectIndex dependsFrom self ;
}

//--------------------------------------------------------------------------------------------------

graphic handlingOpposite entity PackageSlavePad : PackageObject {
  graphic canCopyAndPaste ;

  property @signature @generateDirectAccess CanariLength xCenter default ".zero" ;
  property @signature @generateDirectAccess CanariLength yCenter default ".zero" ;
  property @signature @generateDirectAccess CanariLength width default ".mil (50)" ;
  property @signature @generateDirectAccess CanariLength height default ".mil (100)" ;
  property @signature @generateDirectAccess CanariLength holeWidth default ".mil (25)" ;
  property @signature @generateDirectAccess CanariLength holeHeight default ".mil (25)" ;
  property @signature @generateDirectAccess PadShape padShape default octo ;
  property @signature @generateDirectAccess SlavePadStyle padStyle default traversing ;

  property @signature @generateDirectAccess CanariLengthUnit xCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit yCenterUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit widthUnit  default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit heightUnit  default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit holeWidthUnit default ".mil" ;
  property @signature @generateDirectAccess CanariLengthUnit holeHeightUnit default ".mil" ;
  property @signature CanariLengthUnit annularRingUnit default ".mil" ;

  toOne @weak PackagePad master inverse toMany slaves ;

  override transient EBShape objectDisplay dependsFrom
     self.xCenter, self.yCenter, self.width, self.height, self.holeWidth, self.holeHeight,
     self.padShape, self.padStyle,
     prefs.frontSidePadColor, prefs.displayPackageFrontSidePads,
     prefs.backSidePadColor, prefs.displayPackageBackSidePads
  ;
  override transient EBShape selectionDisplay dependsFrom
     prefs.selectionHiliteColor,
     self.xCenter, self.yCenter, self.width, self.height, self.padShape
  ;

  override transient CanariIssueArray issues dependsFrom
    self.xCenter, self.yCenter, self.width, self.height, self.holeWidth, self.holeHeight
  ;

  transient Bool padIsTraversing dependsFrom self.padStyle ;

  transient CanariLength annularRing dependsFrom self.width, self.height, self.holeWidth, self.holeHeight ;

  transient String padNameWithZoneName dependsFrom self.master.one.padNameWithZoneName ;

  transient String masterPadNameWithZoneName dependsFrom self.master.one.padNameWithZoneName ;

  transient String padNameForDisplay dependsFrom self.master.one.padNameForDisplay ;

   transient EBShape padNumberDisplay dependsFrom
     self.xCenter, self.yCenter,
     prefs.padNumberFont, prefs.padNumberColor, self.padNameForDisplay
  ;
}

