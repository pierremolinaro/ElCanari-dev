//--------------------------------------------------------------------------------------------------
//   BoardLine
//--------------------------------------------------------------------------------------------------

enum BoardLineLayer {
  legendFront, legendBack
}

func enum BoardLineLayer.popupTitles {
  legendFront : "Legend Front Side" ;
  legendBack : "Legend Back Side" ;
 }

//--------------------------------------------------------------------------------------------------

graphic entity BoardLine : BoardObject { 
  graphic canCopyAndPaste ;

  property CanariLength mWidth default ".mil (25)" ;
  property CanariLengthUnit mWidthUnit default ".mil" ; // mil

  property @generateDirectAccess CanariLength mX1 default ".zero" ;
  property @generateDirectAccess CanariLengthUnit mX1Unit default ".mil" ; // mil

  property @generateDirectAccess CanariLength mY1 default ".zero" ;
  property @generateDirectAccess CanariLengthUnit mY1Unit default ".mil" ; // mil

  property @generateDirectAccess CanariLength mX2 default ".mil (200)" ; // 200 mils
  property @generateDirectAccess CanariLengthUnit mX2Unit default ".mil" ; // mil

  property @generateDirectAccess CanariLength mY2 default ".mil (200)" ; // 200 mils
  property @generateDirectAccess CanariLengthUnit mY2Unit default ".mil" ; // mil

  property @generateDirectAccess BoardLineLayer mLayer default legendFront ;

  override transient EBShape objectDisplay dependsFrom
    self.mX1, self.mY1, self.mX2, self.mY2, self.mWidth, self.mLayer,
    prefs.frontSideLegendColorForBoard,
    prefs.backSideLegendColorForBoard
  ;

  override transient EBShape selectionDisplay dependsFrom
    prefs.selectionHiliteColor,
    self.mX1, self.mY1, self.mX2, self.mY2,
    prefs.hiliteWidthMultipliedByTen
  ;
}

//--------------------------------------------------------------------------------------------------
