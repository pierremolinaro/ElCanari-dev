//--------------------------------------------------------------------------------------------------

entity DeviceSlavePadInProject {
  property @generateDirectAccess CanariLength mCenterX default ".zero" ;
  property @generateDirectAccess CanariLength mCenterY default ".zero" ;
  property @generateDirectAccess CanariLength mWidth default ".mil (50)" ;
  property @generateDirectAccess CanariLength mHeight default ".mil (100)" ;
  property @generateDirectAccess CanariLength mHoleWidth default ".mil (25)" ;
  property @generateDirectAccess CanariLength mHoleHeight default ".mil (25)" ;
  property @generateDirectAccess PadShape mShape default octo ;
  property @generateDirectAccess SlavePadStyle mStyle default traversing ;
  
  transient SlavePadDescriptor descriptor dependsFrom
    self.mCenterX,
    self.mCenterY,
    self.mWidth,
    self.mHeight,
    self.mHoleWidth,
    self.mHoleHeight,
    self.mShape,
    self.mStyle ;
}

